<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
    <metadata>
        <id>Microsoft.BingAds.SDK</id>
        <version>13.0.30</version>
        <title>Bing Ads SDK</title>
        <authors>Microsoft</authors>
        <owners>Microsoft</owners>
        <license type="file">LICENSE.md</license>
        <projectUrl>https://docs.microsoft.com/en-us/bingads/guides/client-libraries</projectUrl>
        <requireLicenseAcceptance>true</requireLicenseAcceptance>
        <description>The Bing Ads SDK increases efficiency for Microsoft Advertising developers. The SDK includes SOAP web services proxies, simplified OAuth authentication, and file management with the Bulk and Reporting service operations.</description>
		<readme>docs\README.md</readme>
        <summary />
        <releaseNotes>API Updates:
* Refresh the Bing Ads API Version 13 Campaign Management and Reporting service proxies and generated REST serialization support.
* Add BrandExclusionSetting and its ProductAdsOptOut property while preserving published CampaignAdditionalField flag values.
* Add the JobTitle campaign criterion type and Google import UpdateNCASettings support.
* Add AssetGroupId and AdId columns to the Asset Performance report.
* Update the SDK Api-Revision header to 2026-09-14.

Bulk API Updates:
* Add BulkCompanyList and BulkCompanyItem entities with Company Name and Audience Size CSV mappings and bulk factory support.</releaseNotes>
        <copyright>© Microsoft Corporation. All rights reserved.</copyright>
        <frameworkAssemblies>
            <frameworkAssembly assemblyName="System.ServiceModel" targetFramework="" />
            <frameworkAssembly assemblyName="System.Runtime.Serialization" targetFramework="" />
        </frameworkAssemblies>
	<dependencies>
		<dependency id="Microsoft.CSharp" version="4.7.0" exclude="Build,Analyzers" />
		<dependency id="Microsoft.Extensions.Http" version="9.0.0" exclude="Build,Analyzers" />
		<dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
		<dependency id="System.Dynamic.Runtime" version="4.3.0" exclude="Build,Analyzers" />
		<dependency id="System.ServiceModel.Primitives" version="4.10.2" exclude="Build,Analyzers" />
		<dependency id="System.Text.Json" version="9.0.7" exclude="Build,Analyzers" />
		<dependency id="System.Security.Cryptography.Pkcs" version="6.0.3" exclude="Build,Analyzers" />
	</dependencies>
    </metadata>
    <files>
        <file src="BingAdsApiSDK\bin\Any CPU\Release\netstandard2.0\Microsoft.BingAds.deps.json" target="lib\netstandard2.0\Microsoft.BingAds.deps.json" />
        <file src="BingAdsApiSDK\bin\Any CPU\Release\netstandard2.0\Microsoft.BingAds.dll" target="lib\netstandard2.0\Microsoft.BingAds.dll" />
        <file src="BingAdsApiSDK\bin\Any CPU\Release\netstandard2.0\Microsoft.BingAds.pdb" target="lib\netstandard2.0\Microsoft.BingAds.pdb" />
        <file src="BingAdsApiSDK\bin\Any CPU\Release\netstandard2.0\Microsoft.BingAds.xml" target="lib\netstandard2.0\Microsoft.BingAds.xml" />
        <file src=".\LICENSE.md" target="" />
		<file src=".\README.md" target="docs\" />
    </files>
</package>